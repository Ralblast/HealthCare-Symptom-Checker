# Groq API key — get one at https://console.groq.com (required)
GROQ_API_KEY=

# MongoDB connection string, e.g. Atlas (required)
MONGODB_URI=

# Server
PORT=3001
NODE_ENV=development

# Logging level: error | warn | info | debug
LOG_LEVEL=info

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173
